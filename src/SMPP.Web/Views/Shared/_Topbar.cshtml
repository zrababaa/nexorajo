@{
    string displayName = User.Identity?.Name ?? L["Account"].Value;
    var role = User.IsInRole(RoleNames.Superadmin) ? L["Superadmin"] : L["Account"];
    bool isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
    string initialsFound = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    string initials = initialsFound.Length > 0 ? initialsFound : "?";
}

<header class="app-topbar">
    <button class="topbar-toggle d-md-none" type="button" @@click="toggle()" aria-label="@L["Toggle navigation"]">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <div class="ms-auto d-flex align-items-center gap-3">
        <div class="d-flex small lang-switch">
            <a class="@(!isRtl ? "fw-bold text-body" : "text-muted")" asp-controller="Language" asp-action="SetLanguage" asp-route-culture="en" asp-route-returnUrl="@returnUrl">EN</a>
            <span class="mx-1 text-muted">|</span>
            <a class="@(isRtl ? "fw-bold text-body" : "text-muted")" asp-controller="Language" asp-action="SetLanguage" asp-route-culture="ar" asp-route-returnUrl="@returnUrl">AR</a>
        </div>
        <div class="user-menu">
            <span class="user-avatar">@initials</span>
            <span class="user-menu-text d-none d-sm-block">
                <span class="user-menu-name d-block">@displayName</span>
                <span class="user-menu-role d-block">@role</span>
            </span>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Sign out"]</button>
        </form>
    </div>
</header>
