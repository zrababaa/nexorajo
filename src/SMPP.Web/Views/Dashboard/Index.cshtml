@using SMPP.Domain.Enums
@using SMPP.Infrastructure.Identity
@using SMPP.Web.Services
@using SMPP.Web.ViewModels.Dashboard
@model DashboardViewModel
@{
    ViewData["Title"] = L["Dashboard"];
    bool isSuperadmin = User.IsInRole(RoleNames.Superadmin);
    var s = Model.Summary;

    var chartConfig = System.Net.WebUtility.HtmlEncode(System.Text.Json.JsonSerializer.Serialize(new
    {
        trend = Model.Trend.Select(p => new { date = p.Date.ToString("MMM d"), total = p.Total, delivered = p.Delivered }),
        sourceBreakdown = Model.SourceBreakdown.Select(x => new { label = L[ChartColors.SourceLabel(x.Source)].Value, count = x.Count, color = ChartColors.SourceColor(x.Source) }),
        statusBreakdown = Model.StatusBreakdown.Select(slice => new { label = L[slice.Status.ToString()].Value, count = slice.Count, color = ChartColors.StatusColor(slice.Status) }),
        totalLabel = L["Total"].Value,
        deliveredLabel = L["Delivered"].Value,
        messagesLabel = L["Messages"].Value,
    }));
}

<h1 class="h4 mb-4">@L["Dashboard"]</h1>

<div class="row g-3">
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@L["Credits"]</div>
            <div class="kpi-value">@s.Balance.ToString("N2")</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@L["Sends today"]</div>
            <div class="kpi-value">@s.SendsToday</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@L["Delivery rate"]</div>
            <div class="kpi-value">@(s.DeliveryRatePercent.HasValue ? $"{s.DeliveryRatePercent:0.0}%" : "—")</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="kpi-card d-block text-decoration-none" asp-controller="Payments" asp-action="@(isSuperadmin ? "Review" : "Index")">
            <div class="kpi-label">@L["Pending credit requests"]</div>
            <div class="kpi-value">@s.PendingPayments</div>
        </a>
    </div>

    @if (isSuperadmin)
    {
        <div class="col-sm-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">@L["Total accounts"]</div>
                <div class="kpi-value">@s.TotalAccounts</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">@L["Credits issued (accounts)"]</div>
                <div class="kpi-value">@s.TotalCreditsIssued?.ToString("N2")</div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mt-1">
    <div class="col-sm-6 col-lg-4">
        <a class="btn btn-outline-primary w-100" asp-controller="QuickSend" asp-action="Index">@L["Quick Send"]</a>
    </div>
    <div class="col-sm-6 col-lg-4">
        <a class="btn btn-outline-primary w-100" asp-controller="BulkSend" asp-action="Index">@L["Bulk Send"]</a>
    </div>
    <div class="col-sm-6 col-lg-4">
        <a class="btn btn-outline-primary w-100" asp-controller="History" asp-action="Index">@L["View history"]</a>
    </div>
</div>

<div x-data="dashboardCharts(@Html.Raw(chartConfig))" x-init="init()">
    <div class="row g-3 mt-1">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span>@L["Sends — last 14 days"]</span>
                    <span class="small text-muted">@L["Total vs. delivered"]</span>
                </div>
                <div class="card-body">
                    <canvas id="trendChart" height="110" role="img" aria-label="@L["Line chart of total and delivered messages per day over the last 14 days"]"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header bg-white">@L["Sends by channel"]</div>
                <div class="card-body">
                    <canvas id="sourceChart" height="110" role="img" aria-label="@L["Bar chart of message counts by sending channel"]"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white">@L["Delivery status breakdown (all time)"]</div>
                <div class="card-body">
                    <canvas id="statusChart" height="70" role="img" aria-label="@L["Stacked bar chart of message counts by delivery status"]"></canvas>
                    <ul class="list-unstyled d-flex flex-wrap gap-3 mt-3 mb-0 small">
                        @foreach (var slice in Model.StatusBreakdown)
                        {
                            <li class="d-flex align-items-center gap-2">
                                <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:@ChartColors.StatusColor(slice.Status)"></span>
                                <span>@L[slice.Status.ToString()]: <strong>@slice.Count</strong></span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
