              "raw": "{{baseUrl}}/api/v1/reports/credit-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports", "credit-requests"]
            }
          }
        },
        {
          "name": "Export Report (file)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/{{reportType}}/export?format=csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports", "{{reportType}}", "export"],
              "query": [{ "key": "format", "value": "csv" }]
            },
            "description": "{{reportType}} must be one of the ReportType enum names (see Meta > Enums): Messages, DailyTraffic, Batches, AccountUsage, Transactions, CreditRequests."
          }
        }
      ]
    },
