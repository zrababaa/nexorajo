<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AILogic.Application\AILogic.Application.csproj" />
    <ProjectReference Include="..\AILogic.Infrastructure\AILogic.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\*.html" Link="wwwroot\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\robots.txt" Link="wwwroot\robots.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\sitemap.xml" Link="wwwroot\sitemap.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\**\*" Link="wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
