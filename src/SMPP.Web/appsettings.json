{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    // Brings the schema up to date at startup. Safe against the shared smpp_bulk_db_new: the app
    // creates its own tables there and never touches the daemon's historys/under_process.
    "AutoMigrate": true
  },
  "SmsGateway": {
    "BaseUrl": "",
    "TimeoutSeconds": 30
  }
}
