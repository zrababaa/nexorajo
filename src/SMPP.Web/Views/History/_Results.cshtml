@using Microsoft.AspNetCore.Mvc.Rendering
@using SMPP.Application.Abstractions
@using SMPP.Domain.Enums
@using SMPP.Web.Services
@using SMPP.Web.ViewModels.History
@using SMPP.Web.ViewModels.Shared
@inject ICurrentUserService CurrentUser
@model HistoryIndexViewModel
@{
    var resendableStatuses = new[] { MessageStatus.Failed, MessageStatus.Undelivered, MessageStatus.Expired };
}

<div class="row g-3 mb-1">
    <div class="col-6 col-lg">
        <div class="kpi-card">
            <div class="kpi-label">@L["Total"]</div>
            <div class="kpi-value">@Model.Summary.Total</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="kpi-card">
            <div class="kpi-label">@L["Delivered"]</div>
            <div class="kpi-value" style="color:@ChartColors.StatusColor(MessageStatus.Delivered)">@Model.Summary.Delivered</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="kpi-card">
            <div class="kpi-label">@L["Sent"]</div>
            <div class="kpi-value" style="color:@ChartColors.StatusColor(MessageStatus.Sent)">@Model.Summary.Sent</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="kpi-card">
            <div class="kpi-label">@L["Processing"]</div>
            <div class="kpi-value" style="color:@ChartColors.StatusColor(MessageStatus.Processing)">@Model.Summary.Processing</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="kpi-card">
            <div class="kpi-label">@L["Undelivered"]</div>
            <div class="kpi-value" style="color:@ChartColors.StatusColor(MessageStatus.Undelivered)">@Model.Summary.Undelivered</div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="kpi-card">
            <div class="kpi-label">@L["Failed / Expired"]</div>
            <div class="kpi-value" style="color:@ChartColors.StatusColor(MessageStatus.Failed)">@(Model.Summary.Failed + Model.Summary.Expired)</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@L["Batch"]</th>
                    <th>@L["Channel"]</th>
                    <th>@L["Sender"]</th>
                    <th>@L["Receiver"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["Date (UTC)"]</th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Page.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@L["No messages match these filters."]</td></tr>
                }
                @foreach (var h in Model.Page.Items)
                {
                    <tr>
                        <td><code title="@h.CampaignBatchId">@h.CampaignBatchId[..Math.Min(8, h.CampaignBatchId.Length)]</code></td>
                        <td>@L[ChartColors.SourceLabel(h.Source)]</td>
                        <td>@h.SenderNumber</td>
                        <td>@h.ReceiverNumber</td>
                        <td><span style="color:@ChartColors.StatusColor(h.Status)">&#9679;</span> @L[h.Status.ToString()]</td>
                        <td>@h.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            @if (h.CreatedByUserId == CurrentUser.UserId && resendableStatuses.Contains(h.Status))
                            {
                                <form asp-action="Resend" asp-route-id="@h.Id" asp-route-source="@h.Source" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Resend"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <partial name="_Pagination" model="@PaginationInfo.From(Model.Page)" />
    </div>
</div>
