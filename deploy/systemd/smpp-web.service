[Unit]
Description=Nexora SMS Portal (SMPP.Web)
After=network.target mysql.service

[Service]
Type=notify
WorkingDirectory=/var/www/smpp-web
ExecStart=/var/www/smpp-web/SMPP.Web
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=smpp-web
User=www-data
Group=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5083
# Environment=ConnectionStrings__Default=Server=...;Database=smpp_dotnet;User=...;Password=...;
# Environment=SmsGateway__BaseUrl=https://your-gateway.example.com

[Install]
WantedBy=multi-user.target
