@using SMPP.Application.Common
@using SMPP.Application.Payments
@using SMPP.Domain.Enums
@model PagedResult<PaymentListItemDto>
@{
    ViewData["Title"] = L["Credit Requests"];
    var statusFilter = (PaymentStatus?)ViewBag.StatusFilter;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Credit Requests"]</h1>
    <div class="d-flex flex-wrap gap-1 btn-group-sm" hx-target="#payments-review-results" hx-swap="innerHTML" hx-push-url="true">
        <a class="btn btn-outline-secondary @(statusFilter is null ? "active" : "")" asp-action="Review">@L["All"]</a>
        <a class="btn btn-outline-secondary @(statusFilter == PaymentStatus.Pending ? "active" : "")" asp-action="Review" asp-route-status="Pending">@L["Pending"]</a>
        <a class="btn btn-outline-secondary @(statusFilter == PaymentStatus.Approved ? "active" : "")" asp-action="Review" asp-route-status="Approved">@L["Approved"]</a>
        <a class="btn btn-outline-secondary @(statusFilter == PaymentStatus.Rejected ? "active" : "")" asp-action="Review" asp-route-status="Rejected">@L["Rejected"]</a>
    </div>
</div>

<div x-data="{ open: false, paymentId: null }">

<div id="payments-review-results" hx-target="this" hx-swap="innerHTML" hx-push-url="true">
    <partial name="_ReviewResults" model="Model" />
</div>

<div class="app-modal-backdrop" x-show="open" x-cloak x-transition.opacity @@click="open = false"></div>
<div class="app-modal" x-show="open" x-cloak x-transition @@keydown.escape.window="open = false" role="dialog" aria-modal="true">
    <div class="modal-dialog m-0">
        <form asp-action="Reject" method="post" x-data="submitGuard" @@submit="sending = true">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PaymentId" :value="paymentId" />
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h6">@L["Reject credit request"]</h2>
                    <button type="button" class="btn-close" @@click="open = false" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">@L["Reason (optional, shown to the account)"]</label>
                    <textarea name="ReviewNote" class="form-control" rows="3"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @@click="open = false">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-danger" :disabled="sending">@L["Reject request"]</button>
                </div>
            </div>
        </form>
    </div>
</div>

</div>
