{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    // Brings the schema up to date at startup. Safe against the shared smpp_bulk_db_new: the app
    // creates its own tables there and never touches the daemon's historys/under_process.
    "AutoMigrate": true
  },
  "Api": {
    "Title": "Nexora SMS Platform API",
    // Set to the public URL once the product is online (e.g. https://smpp.example.com) so the
    // Swagger page's "Try it out" targets the real host rather than the one Kestrel sees behind
    // the reverse proxy.
    "PublicBaseUrl": "",
    "ContactEmail": "",
    "EnableSwagger": true,
    // Browser origins allowed to call the API cross-site. Empty means any origin, which is safe
    // because the API authenticates with bearer tokens, not cookies. List them explicitly to
    // lock it down.
    "AllowedCorsOrigins": []
  },
  "Jwt": {
    // Signing key for the API's bearer tokens. No default on purpose - startup fails until it is
    // set, per environment, to at least 32 characters:  openssl rand -base64 48
    "Key": "",
    "Issuer": "smpp-api",
    "Audience": "smpp-api",
    "AccessTokenMinutes": 480,
    "MachineTokenMinutes": 60
  },
  "Email": {
    // SMTP relay used to send spam-keyword-blocked alerts (see SpamKeywordFilterService). Left
    // blank here on purpose: SmtpEmailSender then throws and the alert send is skipped with a
    // logged warning, so a missing mail config never breaks a send request. Fill in per
    // environment - production values live in the gitignored appsettings.Production.json.
    "SmtpHost": "",
    "SmtpPort": 465,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Spam Alerter",
    "SpamAlertRecipient": ""
  }
}
