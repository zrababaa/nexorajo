@using Microsoft.AspNetCore.Mvc.Rendering
@using SMPP.Application.Abstractions
@using SMPP.Domain.Enums
@using SMPP.Web.Services
@using SMPP.Web.ViewModels.History
@model HistoryIndexViewModel
@{
    ViewData["Title"] = L["History"];
    var sourceOptions = new SelectList(Enum.GetValues<MessageSource>().Select(v => new SelectListItem(L[ChartColors.SourceLabel(v)].Value, v.ToString())), "Value", "Text");
    var statusOptions = new SelectList(Enum.GetValues<MessageStatus>().Select(v => new SelectListItem(L[v.ToString()].Value, v.ToString())), "Value", "Text");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Message History"]</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCsv" asp-all-route-data="@BuildFilterRoute()">@L["Export CSV"]</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="ExportExcel" asp-all-route-data="@BuildFilterRoute()">@L["Export Excel"]</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end"
              hx-get="@Url.Action("Index")" hx-target="#history-results" hx-swap="innerHTML" hx-push-url="true"
              hx-trigger="change, keyup changed delay:400ms from:input[type=text], submit">
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["Channel"]</label>
                <select asp-for="Source" class="form-select form-select-sm" asp-items="sourceOptions">
                    <option value="">@L["All"]</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["Status"]</label>
                <select asp-for="Status" class="form-select form-select-sm" asp-items="statusOptions">
                    <option value="">@L["All"]</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["Receiver"]</label>
                <input asp-for="Receiver" class="form-control form-control-sm" placeholder="@L["Phone number"]" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["Batch Id"]</label>
                <input asp-for="CampaignBatchId" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["From"]</label>
                <input asp-for="DateFrom" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["To"]</label>
                <input asp-for="DateTo" class="form-control form-control-sm" />
            </div>
            <div class="col-12 d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-primary btn-sm">@L["Filter"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@L["Clear"]</a>
            </div>
        </form>
    </div>
</div>

<div id="history-results" hx-target="this" hx-swap="innerHTML" hx-push-url="true">
    <partial name="_Results" model="Model" />
</div>

@functions {
    private Dictionary<string, string> BuildFilterRoute()
    {
        var route = new Dictionary<string, string>();
        if (Model.Source.HasValue) route["source"] = Model.Source.Value.ToString();
        if (Model.Status.HasValue) route["status"] = Model.Status.Value.ToString();
        if (!string.IsNullOrEmpty(Model.CampaignBatchId)) route["campaignBatchId"] = Model.CampaignBatchId;
        if (!string.IsNullOrEmpty(Model.Receiver)) route["receiver"] = Model.Receiver;
        if (Model.DateFrom.HasValue) route["dateFrom"] = Model.DateFrom.Value.ToString("yyyy-MM-dd");
        if (Model.DateTo.HasValue) route["dateTo"] = Model.DateTo.Value.ToString("yyyy-MM-dd");
        return route;
    }
}
