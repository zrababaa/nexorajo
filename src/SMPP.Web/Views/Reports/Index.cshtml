@using Microsoft.AspNetCore.Mvc.Rendering
@using SMPP.Application.Reports
@using SMPP.Domain.Enums
@using SMPP.Web.Services
@using SMPP.Web.ViewModels.Reports
@model ReportsViewModel
@{
    ViewData["Title"] = L["Reports"];

    var filter = Model.Filter;
    var sourceOptions = new SelectList(
        Enum.GetValues<MessageSource>().Select(v => new SelectListItem(L[ChartColors.SourceLabel(v)].Value, v.ToString())), "Value", "Text");
    var statusOptions = new SelectList(
        Enum.GetValues<MessageStatus>().Select(v => new SelectListItem(L[v.ToString()].Value, v.ToString())), "Value", "Text");

    // AccountUsage is a comparison across accounts, which only makes sense for the Superadmin.
    var tabs = new List<(ReportType Type, string Label)>
    {
        (ReportType.Messages, "Messages"),
        (ReportType.DailyTraffic, "Daily Traffic"),
        (ReportType.Batches, "Batches"),
    };
    if (filter.IsSuperadmin)
    {
        tabs.Add((ReportType.AccountUsage, "Account Usage"));
    }
    tabs.Add((ReportType.Transactions, "Transactions"));
    tabs.Add((ReportType.CreditRequests, "Credit Requests"));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Reports"]</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-success btn-sm" asp-action="ExportExcel" asp-all-route-data="@filter.RouteValues()">@L["Export Excel"]</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCsv" asp-all-route-data="@filter.RouteValues()">@L["Export CSV"]</a>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    @foreach (var tab in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(filter.Report == tab.Type ? "active" : "")"
               asp-action="Index" asp-all-route-data="@filter.RouteValues(tab.Type)">@L[tab.Label]</a>
        </li>
    }
</ul>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end"
              hx-get="@Url.Action("Index")" hx-target="#report-results" hx-swap="innerHTML" hx-push-url="true"
              hx-trigger="change, submit">
            <input type="hidden" name="report" value="@filter.Report" />

            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["From"]</label>
                <input type="date" name="dateFrom" value="@(filter.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small mb-1">@L["To"]</label>
                <input type="date" name="dateTo" value="@(filter.DateTo?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            @if (filter.ShowChannel)
            {
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label small mb-1">@L["Channel"]</label>
                    <select name="source" class="form-select form-select-sm" asp-items="sourceOptions">
                        <option value="">@L["All"]</option>
                    </select>
                </div>
            }

            @if (filter.ShowStatus)
            {
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label small mb-1">@L["Status"]</label>
                    <select name="status" class="form-select form-select-sm" asp-items="statusOptions">
                        <option value="">@L["All"]</option>
                    </select>
                </div>
            }

            @if (filter.IsSuperadmin)
            {
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label small mb-1">@L["Account"]</label>
                    <select name="accountId" class="form-select form-select-sm">
                        <option value="">@L["All"]</option>
                        @foreach (var account in filter.Accounts)
                        {
                            <option value="@account.Id" selected="@(filter.AccountId == account.Id)">@account.Username</option>
                        }
                    </select>
                </div>
            }

            <div class="col-12 d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-primary btn-sm">@L["Filter"]</button>
                <a asp-action="Index" asp-route-report="@filter.Report" class="btn btn-outline-secondary btn-sm">@L["Clear"]</a>
            </div>
        </form>
    </div>
</div>

<div id="report-results" hx-target="this" hx-swap="innerHTML" hx-push-url="true">
    <partial name="_Results" model="Model" />
</div>
