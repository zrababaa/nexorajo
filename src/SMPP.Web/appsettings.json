{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    // Leave false against smpp_bulk_db_new: that database is shared with the legacy Laravel app
    // and the SMPP daemon, and EF has no migration history describing its tables.
    "AutoMigrate": false
  },
  "SmsGateway": {
    "BaseUrl": "",
    "TimeoutSeconds": 30
  }
}
