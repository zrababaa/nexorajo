{
  "info": {
    "name": "SMPP Bulk Messaging API",
    "description": "REST API (api/v1) plus the two legacy endpoints (send-message-api, getStatus) for the SMPP bulk messaging platform. Sign in with Auth > Login or Auth > Machine Token first — both auto-fill the {{accessToken}} collection variable used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5083" },
    { "key": "accessToken", "value": "" },
    { "key": "identifier", "value": "admin" },
    { "key": "password", "value": "ChangeMe123!" },
    { "key": "tokenId", "value": "" },
    { "key": "secretKey", "value": "" },
    { "key": "campaignId", "value": "1" },
    { "key": "accountId", "value": "1" },
    { "key": "historyId", "value": "1" },
    { "key": "spamKeywordId", "value": "1" },
    { "key": "paymentId", "value": "1" },
    { "key": "reportType", "value": "Messages" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Signs in with a username (or email) and password. Returns a bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Machine Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tokenId\": \"{{tokenId}}\",\n  \"secretKey\": \"{{secretKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "token"]
            },
            "description": "Exchanges an account's API token-id/secret-key pair for a bearer token. Get these from Accounts > Regenerate API Credentials (Superadmin) or Auth > Me."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "The signed-in account: profile, balance, sender-ID policy, and API credentials."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"ChangeMe123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "change-password"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Always answers 202. No mail transport is wired up yet — the reset token is written to the app log."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"token\": \"paste-token-from-log\",\n  \"password\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          }
        },
        {
          "name": "Enums",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/enums",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "enums"]
            },
            "description": "Every enum the API uses (UserRole, MessageSource, MessageStatus, etc.) as name/value pairs."
          }
        }
      ]
    },
    {
      "name": "Messaging",
      "item": [
        {
          "name": "Get Send Policy",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/send-policy",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "send-policy"]
            }
          }
        },
        {
          "name": "Preview Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello from SMPP\",\n  \"recipientCount\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "preview"]
            },
            "description": "Prices a message without sending it: segment count and total cost."
          }
        },
        {
          "name": "Quick Send",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numbers\": \"962790000000, 962790000001\",\n  \"message\": \"Hello from SMPP\",\n  \"senderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/quick-send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "quick-send"]
            },
            "description": "Sends to numbers supplied inline. Returns 202 with a batch id and a `statuses` array (each recipient's delivery status as of 2 seconds after queuing); keep polling History > List History with that campaignBatchId for the final outcome."
          }
        },
        {
          "name": "Bulk Send",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaignId\": {{campaignId}},\n  \"message\": \"Hello from SMPP\",\n  \"senderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/bulk-send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "bulk-send"]
            },
            "description": "Sends to every number in one of your saved lists (Campaigns)."
          }
        },
        {
          "name": "Get Pricing",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/pricing",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "pricing"]
            }
          }
        }
      ]
    },
    {
      "name": "Campaigns",
      "item": [
        {
          "name": "List Campaigns",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campaigns"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Campaign By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Create Campaign",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Recipient List\",\n  \"externalCampaignCode\": null,\n  \"numbers\": \"962790000000, 962790000001\\n962790000002\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campaigns"]
            }
          }
        },
        {
          "name": "Import Campaign (file)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "Name", "value": "Imported List", "type": "text" },
                { "key": "ExternalCampaignCode", "value": "", "type": "text" },
                { "key": "File", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campaigns", "import"]
            },
            "description": "Imports a recipient list from a CSV/TXT/XLSX file. Set the File field to a local file before sending."
          }
        },
        {
          "name": "Update Campaign",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Renamed List\",\n  \"numbers\": \"962790000000, 962790000001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Delete Campaign",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campaigns", "{{campaignId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "History",
      "item": [
        {
          "name": "List History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/history?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "history"],
              "query": [
                { "key": "source", "value": "QuickSend", "disabled": true },
                { "key": "status", "value": "Delivered", "disabled": true },
                { "key": "campaignBatchId", "value": "", "disabled": true },
                { "key": "receiver", "value": "", "disabled": true },
                { "key": "dateFrom", "value": "", "disabled": true },
                { "key": "dateTo", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "History Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "history", "summary"]
            }
          }
        },
        {
          "name": "History Rows (JSON export)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/rows",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "history", "rows"]
            }
          }
        },
        {
          "name": "Export History (file)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/export?format=csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "history", "export"],
              "query": [{ "key": "format", "value": "csv" }]
            }
          }
        },
        {
          "name": "Resend Message",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/{{historyId}}/resend?source=QuickSend",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "history", "{{historyId}}", "resend"],
              "query": [{ "key": "source", "value": "QuickSend" }]
            },
            "description": "Re-queues a Failed/Undelivered/Expired message as a new single-recipient batch. Source must match which history the id came from."
          }
        }
      ]
    },
    {
