<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SMPP.Domain\SMPP.Domain.csproj" />
    <ProjectReference Include="..\SMPP.Application\SMPP.Application.csproj" />
    <ProjectReference Include="..\SMPP.Infrastructure\SMPP.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The XML file feeds Swagger: the doc comments on the API controllers become the endpoint
      descriptions on the published page. 1591 stays off - documenting every internal member
      just to satisfy the compiler would drown the comments that are actually published.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!--
    Keep local-dev credentials and the settings template out of the server bundle. Deleting after
    publish rather than excluding as Content, so `dotnet run` still picks both up locally.
  -->
  <Target Name="StripNonProductionSettings" AfterTargets="Publish">
    <Delete Files="$(PublishDir)appsettings.Development.json;$(PublishDir)appsettings.Production.example.json" />
  </Target>

</Project>
