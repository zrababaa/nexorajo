@using SMPP.Application.Common
@using SMPP.Application.Payments
@using SMPP.Domain.Enums
@using SMPP.Web.ViewModels.Shared
@model SMPP.Web.ViewModels.Payments.SubmitPaymentViewModel
@{
    ViewData["Title"] = L["Request Credits"];
    var requests = (PagedResult<PaymentListItemDto>)ViewBag.Requests;

    string StatusBadge(PaymentStatus status) => status switch
    {
        PaymentStatus.Approved => "bg-success",
        PaymentStatus.Rejected => "bg-danger",
        _ => "bg-warning text-dark",
    };
}

<h1 class="h4 mb-4">@L["Request Credits"]</h1>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white">@L["Submit a top-up request"]</div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" step="0.01" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Method" class="form-label"></label>
                        <select asp-for="Method" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TransactionRef" class="form-label"></label>
                        <input asp-for="TransactionRef" class="form-control" placeholder="@L["UTR / transaction id"]" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ProofFile" class="form-label"></label>
                        <input asp-for="ProofFile" class="form-control" type="file" accept="image/*,.pdf" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@L["Submit request"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white">@L["My requests"]</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>@L["Amount"]</th>
                            <th>@L["Method"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Submitted"]</th>
                            <th>@L["Note"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!requests.Items.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">@L["No requests yet."]</td></tr>
                        }
                        @foreach (var r in requests.Items)
                        {
                            <tr>
                                <td>@r.Amount.ToString("N2")</td>
                                <td>@r.Method</td>
                                <td><span class="badge @StatusBadge(r.Status)">@L[r.Status.ToString()]</span></td>
                                <td>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small text-muted">@(r.Status == PaymentStatus.Rejected ? r.ReviewNote : r.Note)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white">
                <partial name="_Pagination" model="@(new PaginationInfo(requests.PageNumber, requests.TotalPages))" />
            </div>
        </div>
    </div>
</div>
