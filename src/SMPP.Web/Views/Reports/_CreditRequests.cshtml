@using SMPP.Application.Reports
@using SMPP.Domain.Enums
@model IReadOnlyList<CreditRequestRowDto>
@{
    string StatusBadge(PaymentStatus status) => status switch
    {
        PaymentStatus.Approved => "bg-success",
        PaymentStatus.Rejected => "bg-danger",
        _ => "bg-warning text-dark",
    };
}

<table class="table table-hover table-sm mb-0 align-middle">
    <thead>
        <tr>
            <th>@L["Date (UTC)"]</th>
            <th>@L["Account"]</th>
            <th class="text-end">@L["Amount"]</th>
            <th>@L["Method"]</th>
            <th>@L["Reference"]</th>
            <th>@L["Status"]</th>
            <th>@L["Reviewed"]</th>
            <th>@L["Note"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-center text-muted py-4">@L["No rows match these filters."]</td></tr>
        }
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@r.Username</td>
                <td class="text-end fw-semibold">@r.Amount.ToString("N2")</td>
                <td>@r.Method</td>
                <td>@r.TransactionRef</td>
                <td><span class="badge @StatusBadge(r.Status)">@L[r.Status.ToString()]</span></td>
                <td>@(r.ReviewedAt?.ToString("yyyy-MM-dd HH:mm"))</td>
                <td class="text-truncate" style="max-width:16rem" title="@r.ReviewNote">@r.ReviewNote</td>
            </tr>
        }
    </tbody>
    @if (Model.Any())
    {
        <tfoot class="table-light fw-semibold">
            <tr>
                <td colspan="2">@L["Approved total"]</td>
                <td class="text-end">
                    @Model.Where(r => r.Status == PaymentStatus.Approved).Sum(r => r.Amount).ToString("N2")
                </td>
                <td colspan="5"></td>
            </tr>
        </tfoot>
    }
</table>
