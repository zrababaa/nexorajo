@model SMPP.Web.ViewModels.Sending.SendFormViewModel
@{
    // Charged per part, so the readout has to show parts and not just characters - see site.js,
    // which mirrors the server's SegmentCounter to work them out.
    var rate = (ViewData["SendPolicy"] as SMPP.Application.Abstractions.SendPolicy)?.RatePerMessage ?? 0m;
    var counterTemplate = L["{chars} characters · {parts} part(s) · {encoding}"].Value;
    var creditsTemplate = L["{credits} credits per recipient"].Value;
}

<div class="mb-3">
    <label asp-for="Message" class="form-label"></label>
    <textarea asp-for="Message" id="messageText" class="form-control" rows="4"></textarea>
    <div class="form-text"
         data-message-counter-for="messageText"
         data-rate="@rate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-template="@counterTemplate"
         data-credits-template="@creditsTemplate"
         data-unicode-label="@L["Unicode"]"
         data-latin-label="@L["GSM"]"></div>
    <span asp-validation-for="Message" class="text-danger small"></span>
</div>
