@using SMPP.Web.ViewModels.Accounts
@model EditAccountViewModel
@{
    ViewData["Title"] = "Manage account";
}

<h1 class="h4 mb-4">Manage account: @Model.Username</h1>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Account details</h2>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input class="form-control" value="@Model.Username" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.Email" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MobileNo" class="form-label"></label>
                        <input asp-for="MobileNo" class="form-control" />
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="RatePerMessage" class="form-label"></label>
                            <input asp-for="RatePerMessage" class="form-control" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="SenderId" class="form-label"></label>
                            <input asp-for="SenderId" class="form-control" maxlength="20" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="DateFrom" class="form-label"></label>
                            <input asp-for="DateFrom" type="date" class="form-control" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="DateTo" class="form-label"></label>
                            <input asp-for="DateTo" type="date" class="form-control" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Credits</h2>
                <div class="kpi-card mb-3">
                    <div class="kpi-label">Current credits</div>
                    <div class="kpi-value">@Model.Balance.ToString("N2")</div>
                </div>

                <form asp-action="Credit" method="post" class="d-flex gap-2 mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AccountId" value="@Model.Id" />
                    <input type="number" step="0.01" name="Amount" class="form-control" placeholder="Amount" required />
                    <button type="submit" class="btn btn-success">Credit</button>
                </form>
                <form asp-action="Debit" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AccountId" value="@Model.Id" />
                    <input type="number" step="0.01" name="Amount" class="form-control" placeholder="Amount" required />
                    <button type="submit" class="btn btn-outline-danger">Debit</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h6">API credentials</h2>
                @if (!string.IsNullOrEmpty(Model.ApiToken))
                {
                    <p class="small mb-1"><strong>Token:</strong> <code>@Model.ApiToken</code></p>
                    <p class="small mb-3"><strong>Secret:</strong> <code>@Model.ApiSecret</code></p>
                }
                else
                {
                    <p class="small text-muted mb-3">No API credentials generated yet.</p>
                }
                <form asp-action="RegenerateApiCredentials" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Regenerating will invalidate the current credentials. Continue?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm">Regenerate credentials</button>
                </form>
            </div>
        </div>
    </div>
</div>
