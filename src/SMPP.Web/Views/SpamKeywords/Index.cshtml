@using Microsoft.AspNetCore.Mvc.Rendering
@using SMPP.Application.SpamKeywords
@using SMPP.Domain.Enums
@using SMPP.Web.ViewModels.Shared
@using SMPP.Web.ViewModels.SpamKeywords
@model SpamKeywordsPageViewModel
@{
    ViewData["Title"] = L["Spam Keywords"];
    var confirmDelete = L["Delete this keyword?"].Value;
    var keywordTypes = new SelectList(Enum.GetValues<SpamKeywordType>().Select(v => new SelectListItem(L[v.ToString()].Value, v.ToString())), "Value", "Text");
}

<h1 class="h4 mb-4">@L["Content Filter Keywords"]</h1>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">@L["Add keyword"]</h2>
                <form asp-action="Create" method="post">
                    @{
                        var newModel = new CreateSpamKeywordViewModel();
                    }
                    <div class="mb-3">
                        <label class="form-label">@L["Keyword"]</label>
                        <input name="Keyword" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Type"]</label>
                        <select name="KeywordType" class="form-select" asp-items="keywordTypes"></select>
                    </div>
                    <button type="submit" class="btn btn-primary">@L["Add"]</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>@L["Keyword"]</th>
                            <th>@L["Type"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Added"]</th>
                            <th class="text-end">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Keywords.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">@L["No keywords configured."]</td></tr>
                        }
                        @foreach (var k in Model.Keywords)
                        {
                            <tr>
                                <td>@k.Keyword</td>
                                <td>@L[k.KeywordType.ToString()]</td>
                                <td>
                                    @if (k.IsEnabled)
                                    {
                                        <span class="badge bg-success">@L["Enabled"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@L["Disabled"]</span>
                                    }
                                </td>
                                <td>@k.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <form asp-action="ToggleEnabled" asp-route-id="@k.Id" asp-route-isEnabled="@(!k.IsEnabled)" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @if (k.IsEnabled)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Disable"]</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">@L["Enable"]</button>
                                        }
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@k.Id" method="post" class="d-inline" onsubmit="return confirm('@confirmDelete');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<h1 class="h4 mt-4 mb-4">@L["Blocked Attempts"]</h1>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle">
            <thead>
                <tr>
                    <th>@L["Date (UTC)"]</th>
                    <th>@L["Account"]</th>
                    <th>@L["Channel"]</th>
                    <th>@L["Sender"]</th>
                    <th class="text-end">@L["Recipients"]</th>
                    <th>@L["Matched Terms"]</th>
                    <th>@L["Message"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.BlockedAttempts.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@L["No blocked attempts yet."]</td></tr>
                }
                @foreach (var a in Model.BlockedAttempts.Items)
                {
                    <tr>
                        <td>@a.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@a.Username</td>
                        <td>@L[a.Source.ToString()]</td>
                        <td>@a.SenderId</td>
                        <td class="text-end">@a.RecipientCount</td>
                        <td class="text-danger">@a.MatchedTerms</td>
                        <td class="small text-muted">@a.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <partial name="_Pagination" model="@(new PaginationInfo(Model.BlockedAttempts.PageNumber, Model.BlockedAttempts.TotalPages))" />
    </div>
</div>
