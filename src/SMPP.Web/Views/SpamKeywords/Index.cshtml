@using SMPP.Application.SpamKeywords
@using SMPP.Web.ViewModels.SpamKeywords
@model IReadOnlyList<SpamKeywordListItemDto>
@{
    ViewData["Title"] = "Spam Keywords";
}

<h1 class="h4 mb-4">Content Filter Keywords</h1>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Add keyword</h2>
                <form asp-action="Create" method="post">
                    @{
                        var newModel = new CreateSpamKeywordViewModel();
                    }
                    <div class="mb-3">
                        <label class="form-label">Keyword</label>
                        <input name="Keyword" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select name="KeywordType" class="form-select" asp-items="Html.GetEnumSelectList<SMPP.Domain.Enums.SpamKeywordType>()"></select>
                    </div>
                    <button type="submit" class="btn btn-primary">Add</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Keyword</th>
                            <th>Type</th>
                            <th>Added</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No keywords configured.</td></tr>
                        }
                        @foreach (var k in Model)
                        {
                            <tr>
                                <td>@k.Keyword</td>
                                <td>@k.KeywordType</td>
                                <td>@k.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <form asp-action="Delete" asp-route-id="@k.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this keyword?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
