@using SMPP.Application.Campaigns
@using SMPP.Application.Common
@using SMPP.Web.ViewModels.Shared
@model PagedResult<CampaignListItemDto>
@{
    ViewData["Title"] = L["Campaigns"];
    var confirmDelete = L["Delete this campaign?"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Campaigns"]</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">+ @L["New campaign"]</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@L["Name"]</th>
                    <th>@L["Code"]</th>
                    <th>@L["Source"]</th>
                    <th>@L["Recipients"]</th>
                    <th>@L["Created"]</th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@L["No campaigns yet."]</td></tr>
                }
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td><code>@c.ExternalCampaignCode</code></td>
                        <td>@L[c.SourceType.ToString()]</td>
                        <td>@c.RecipientCount</td>
                        <td>@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">@L["Edit"]</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" hx-confirm="@confirmDelete">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <partial name="_Pagination" model="@PaginationInfo.From(Model)" />
    </div>
</div>
