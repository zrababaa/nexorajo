@using SMPP.Application.Common
@using SMPP.Application.Reports
@using SMPP.Domain.Enums
@model (PagedResult<TransactionReportRowDto> Page, TransactionTotals Totals)

<table class="table table-hover table-sm mb-0 align-middle">
    <thead>
        <tr>
            <th>@L["Date (UTC)"]</th>
            <th>@L["Account"]</th>
            <th>@L["Type"]</th>
            <th>@L["Source"]</th>
            <th class="text-end">@L["Amount"]</th>
            <th>@L["Batch"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Page.Items.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">@L["No rows match these filters."]</td></tr>
        }
        @foreach (var r in Model.Page.Items)
        {
            <tr>
                <td>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@r.Username</td>
                <td>
                    @if (r.Kind == TransactionKind.Credit)
                    {
                        <span class="badge bg-success">@L["Credit"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@L["Debit"]</span>
                    }
                </td>
                <td>@L[r.Source.ToString()]</td>
                <td class="text-end fw-semibold">@(r.Kind == TransactionKind.Credit ? "+" : "-")@r.Amount.ToString("N2")</td>
                <td>
                    @if (!string.IsNullOrEmpty(r.RelatedBatchId))
                    {
                        <code title="@r.RelatedBatchId">@r.RelatedBatchId[..Math.Min(10, r.RelatedBatchId.Length)]</code>
                    }
                </td>
            </tr>
        }
    </tbody>
    @if (Model.Page.Items.Any())
    {
        <tfoot class="table-light fw-semibold">
            <tr>
                <td colspan="4">@L["Net change"]</td>
                <td class="text-end">@Model.Totals.NetChange.ToString("N2")</td>
                <td></td>
            </tr>
        </tfoot>
    }
</table>
