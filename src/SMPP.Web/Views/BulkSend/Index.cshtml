@using SMPP.Application.Campaigns
@using SMPP.Application.Common
@using SMPP.Application.History
@using SMPP.Web.ViewModels.Shared
@model SMPP.Web.ViewModels.Sending.BulkSendViewModel
@{
    ViewData["Title"] = L["Bulk Send"];
    var history = (PagedResult<HistoryListItemDto>)ViewBag.History;
    var campaigns = (IEnumerable<CampaignListItemDto>)ViewBag.Campaigns;
    var spamBlockedTerms = ViewBag.SpamBlockedTerms as IReadOnlyCollection<string>;
}

@if (spamBlockedTerms is not null)
{
    <partial name="_SpamBlockedModal" model="spamBlockedTerms" />
}

<h1 class="h4 mb-4">@L["Bulk Send"]</h1>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                @if (!campaigns.Any())
                {
                    <p class="text-muted small">@L["You have no campaigns yet."] <a asp-controller="Campaigns" asp-action="Create">@L["Create one"]</a> @L["first."]</p>
                }
                <form asp-action="Submit" method="post">
                    <div class="mb-3">
                        <label asp-for="CampaignId" class="form-label"></label>
                        <select asp-for="CampaignId" class="form-select">
                            <option value="">@L["Select a campaign..."]</option>
                            @foreach (var c in campaigns)
                            {
                                <option value="@c.Id">@c.Name (@c.RecipientCount @L["Recipients"])</option>
                            }
                        </select>
                        <span asp-validation-for="CampaignId" class="text-danger small"></span>
                    </div>
                    <partial name="_MessageField" model="Model" />
                    <partial name="_SenderIdField" model="Model" />
                    <button type="submit" class="btn btn-primary w-100">@L["Send"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white">@L["Recent Bulk Send history"]</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>@L["Batch"]</th>
                            <th>@L["Sender"]</th>
                            <th>@L["Receiver"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Sent"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!history.Items.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">@L["No sends yet."]</td></tr>
                        }
                        @foreach (var h in history.Items)
                        {
                            <tr>
                                <td><code>@h.CampaignBatchId[..8]</code></td>
                                <td>@h.SenderNumber</td>
                                <td>@h.ReceiverNumber</td>
                                <td>@L[h.Status.ToString()]</td>
                                <td>@h.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white">
                <partial name="_Pagination" model="@(new PaginationInfo(history.PageNumber, history.TotalPages))" />
            </div>
        </div>
    </div>
</div>
