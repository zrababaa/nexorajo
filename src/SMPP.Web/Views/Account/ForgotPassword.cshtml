@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<p class="text-muted small">Enter your account email and we'll send you a password reset link.</p>

<form asp-controller="Account" asp-action="ForgotPassword" method="post">
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Send reset link</button>

    <div class="text-center mt-3 small">
        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </div>
</form>
