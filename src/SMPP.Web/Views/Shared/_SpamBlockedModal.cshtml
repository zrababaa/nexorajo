@model IReadOnlyCollection<string>
@{
    // Rendered only when a send was rejected by the content filter, and opened straight away by
    // site.js: a blocked send has to be impossible to miss, unlike the dismissible flash strip.
}

<div class="modal fade" id="spamBlockedModal" tabindex="-1" aria-labelledby="spamBlockedModalLabel" aria-hidden="true" data-show-on-load>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-danger" id="spamBlockedModalLabel">@L["Message not sent"]</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@L["The content filter found the following blocked term(s) in your message:"]</p>
                <ul class="mb-3">
                    @foreach (var term in Model)
                    {
                        <li><strong>@term</strong></li>
                    }
                </ul>
                <p class="mb-0 text-muted small">@L["Nothing was sent and no credits were charged. Edit the message and try again."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">@L["Edit message"]</button>
            </div>
        </div>
    </div>
</div>
