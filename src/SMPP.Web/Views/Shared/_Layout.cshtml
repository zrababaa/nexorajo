@{
    bool isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexora SMS Portal</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/@(isRtl ? "bootstrap.rtl.min.css" : "bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* htmx/Chart.js/app.js/Alpine live in <head>, never inside the hx-boost swap region, so a
       boosted navigation can't cause them to be re-fetched and re-executed on every page. *@
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/lib/alpinejs/alpine.min.js" defer></script>
</head>
<body hx-boost="true">
    <div class="app-shell" x-data="sidebar">
        <partial name="_Sidebar" />

        <div class="app-main">
            <partial name="_Topbar" />

            <main class="app-content" id="app-content">
                <partial name="_FlashMessages" />
                @RenderBody()
            </main>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
