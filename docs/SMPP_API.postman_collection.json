    {
      "name": "Spam Keywords (Superadmin)",
      "item": [
        {
          "name": "List Spam Keywords",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/spam-keywords",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "spam-keywords"]
            }
          }
        },
        {
          "name": "Create Spam Keyword",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keyword\": \"free-money\",\n  \"keywordType\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/spam-keywords",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "spam-keywords"]
            },
            "description": "keywordType: 0=Include (block on match), 1=Exclude, 2=Url — confirm exact values via Meta > Enums (spamKeywordType)."
          }
        },
        {
          "name": "Delete Spam Keyword",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/spam-keywords/{{spamKeywordId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "spam-keywords", "{{spamKeywordId}}"]
            }
          }
        },
        {
          "name": "Enable/Disable Spam Keyword",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/spam-keywords/{{spamKeywordId}}/enabled?isEnabled=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "spam-keywords", "{{spamKeywordId}}", "enabled"],
              "query": [{ "key": "isEnabled", "value": "true" }]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Upload Proof (file)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "File", "type": "file", "src": "" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/proof",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "proof"]
            },
            "description": "Returns a stored path; pass it as proofFilePath in Submit Payment."
          }
        },
        {
          "name": "Submit Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100,\n  \"method\": 0,\n  \"transactionRef\": \"TXN-12345\",\n  \"note\": \"Top-up\",\n  \"proofFilePath\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            },
            "description": "method is a PaymentMethod enum value — see Meta > Enums (paymentMethod)."
          }
        },
        {
          "name": "My Payments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/mine?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "mine"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Review Queue (Superadmin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/review?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "review"],
              "query": [
                { "key": "status", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Approve Payment (Superadmin)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Payment (Superadmin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"Proof unclear, please resubmit.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}", "reject"]
            }
          }
        }
      ]
    },
    {
      "name": "Legacy API",
      "item": [
        {
          "name": "Send Message (legacy)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "token-id", "value": "{{tokenId}}" },
              { "key": "secret-key", "value": "{{secretKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numbers\": \"962790000000, 962790000001\",\n  \"message\": \"Hello from SMPP\",\n  \"senderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/send-message-api",
              "host": ["{{baseUrl}}"],
              "path": ["api", "send-message-api"]
            },
            "description": "Legacy integration route, authenticated via token-id/secret-key headers instead of a bearer token. Same pipeline as Quick Send."
          }
        },
        {
          "name": "Delivery Status Callback",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/getStatus?message_id=EXAMPLE-MSG-ID&status=DELIVRD",
              "host": ["{{baseUrl}}"],
              "path": ["api", "getStatus"],
              "query": [
                { "key": "message_id", "value": "EXAMPLE-MSG-ID" },
                { "key": "status", "value": "DELIVRD" }
              ]
            },
            "description": "Called by the external SMPP daemon as delivery receipts come back. status one of: PROCESS, SENT, DELIVRD, UNDELIV, EXPIRED, FAILED."
          }
        }
      ]
    }
  ]
}
