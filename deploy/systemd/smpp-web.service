[Unit]
Description=Nexora SMS Portal (SMPP.Web)
After=network.target mysql.service

[Service]
Type=notify
WorkingDirectory=/var/www/smpp-web
ExecStart=/var/www/smpp-web/SMPP.Web
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=smpp-web
User=www-data
Group=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5083
# Connection string, gateway URL and seed passwords live in appsettings.Production.json, which
# ASPNETCORE_ENVIRONMENT=Production above makes ASP.NET load on top of appsettings.json. That file
# is gitignored and ships inside the publish bundle - see appsettings.Production.example.json.
# Anything set here would override it, so leave it empty unless you mean to.

[Install]
WantedBy=multi-user.target
