@{
    string current = (string?)ViewContext.RouteData.Values["controller"] ?? string.Empty;
    bool isSuperadmin = User.IsInRole(RoleNames.Superadmin);

    bool IsActive(string controllerName) =>
        string.Equals(current, controllerName, StringComparison.OrdinalIgnoreCase);
}

<nav class="app-sidebar" id="appSidebar">
    <a class="brand" href="/">
        <img src="~/images/nexora-logo.png" alt="Nexora SMS Portal" class="brand-logo" />
    </a>

    <div class="nav flex-column">
        <div class="nav-section-title">@L["Overview"]</div>
        <a class="nav-link @(IsActive("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
            @L["Dashboard"]
        </a>

        <div class="nav-section-title">@L["Messaging"]</div>
        <a class="nav-link @(IsActive("QuickSend") ? "active" : "")" asp-controller="QuickSend" asp-action="Index">
            @L["Quick Send"]
        </a>
        <a class="nav-link @(IsActive("BulkSend") ? "active" : "")" asp-controller="BulkSend" asp-action="Index">
            @L["Bulk Send"]
        </a>
        <a class="nav-link @(IsActive("Campaigns") ? "active" : "")" asp-controller="Campaigns" asp-action="Index">
            @L["Campaigns"]
        </a>
        <a class="nav-link @(IsActive("History") ? "active" : "")" asp-controller="History" asp-action="Index">
            @L["History"]
        </a>

        @if (!isSuperadmin)
        {
            <div class="nav-section-title">@L["Billing"]</div>
            <a class="nav-link @(IsActive("Payments") ? "active" : "")" asp-controller="Payments" asp-action="Index">
                @L["Request Credits"]
            </a>
        }

        @if (isSuperadmin)
        {
            <div class="nav-section-title">@L["Administration"]</div>
            <a class="nav-link @(IsActive("Accounts") ? "active" : "")" asp-controller="Accounts" asp-action="Index">
                @L["Accounts"]
            </a>
            <a class="nav-link @(IsActive("Payments") ? "active" : "")" asp-controller="Payments" asp-action="Review">
                @L["Credit Requests"]
            </a>
            <a class="nav-link @(IsActive("SpamKeywords") ? "active" : "")" asp-controller="SpamKeywords" asp-action="Index">
                @L["Content Filter"]
            </a>
        }
    </div>
</nav>
