@model SMPP.Web.ViewModels.AccountsLogs.AccountsLogsViewModel
@{
    ViewData["Title"] = L["Accounts Logs"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Accounts Logs"]</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-success btn-sm" asp-action="ExportExcel" asp-all-route-data="@Model.RouteValues()">@L["Export Excel"]</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCsv" asp-all-route-data="@Model.RouteValues()">@L["Export CSV"]</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end"
              hx-get="@Url.Action("Index")" hx-target="#accountslogs-results" hx-swap="innerHTML" hx-push-url="true"
              hx-trigger="change, submit">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label small mb-1">@L["From"]</label>
                <input type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label small mb-1">@L["To"]</label>
                <input type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label small mb-1">@L["Account"]</label>
                <select name="accountId" class="form-select form-select-sm">
                    <option value="">@L["All"]</option>
                    @foreach (var account in Model.Accounts)
                    {
                        <option value="@account.Id" selected="@(Model.AccountId == account.Id)">@account.Username</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-3 d-flex gap-2 mt-2 mt-lg-0">
                <button type="submit" class="btn btn-primary btn-sm">@L["Filter"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@L["Clear"]</a>
            </div>
        </form>
    </div>
</div>

<div id="accountslogs-results" hx-target="this" hx-swap="innerHTML" hx-push-url="true">
    <partial name="_Results" model="(Page: Model.Batches, Totals: Model.BatchTotals)" />
</div>
