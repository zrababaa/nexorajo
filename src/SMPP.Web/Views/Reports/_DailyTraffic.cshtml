@using SMPP.Application.Common
@using SMPP.Application.Reports
@using SMPP.Domain.Enums
@using SMPP.Web.Services
@model (PagedResult<DailyTrafficRowDto> Page, DailyTrafficTotals Totals)

<table class="table table-hover table-sm mb-0 align-middle">
    <thead>
        <tr>
            <th>@L["Date"]</th>
            <th class="text-end">@L["Total"]</th>
            <th class="text-end">@L["Delivered"]</th>
            <th class="text-end">@L["Sent"]</th>
            <th class="text-end">@L["Processing"]</th>
            <th class="text-end">@L["Undelivered"]</th>
            <th class="text-end">@L["Failed"]</th>
            <th class="text-end">@L["Expired"]</th>
            <th class="text-end">@L["Delivery rate"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Page.Items.Any())
        {
            <tr><td colspan="9" class="text-center text-muted py-4">@L["No rows match these filters."]</td></tr>
        }
        @foreach (var r in Model.Page.Items)
        {
            <tr>
                <td>@r.Date.ToString("yyyy-MM-dd")</td>
                <td class="text-end fw-semibold">@r.Total</td>
                <td class="text-end" style="color:@ChartColors.StatusColor(MessageStatus.Delivered)">@r.Delivered</td>
                <td class="text-end" style="color:@ChartColors.StatusColor(MessageStatus.Sent)">@r.Sent</td>
                <td class="text-end" style="color:@ChartColors.StatusColor(MessageStatus.Processing)">@r.Processing</td>
                <td class="text-end" style="color:@ChartColors.StatusColor(MessageStatus.Undelivered)">@r.Undelivered</td>
                <td class="text-end" style="color:@ChartColors.StatusColor(MessageStatus.Failed)">@r.Failed</td>
                <td class="text-end" style="color:@ChartColors.StatusColor(MessageStatus.Expired)">@r.Expired</td>
                <td class="text-end">@(r.DeliveryRate.HasValue ? $"{r.DeliveryRate:0.#}%" : "-")</td>
            </tr>
        }
    </tbody>
    @if (Model.Page.Items.Any())
    {
        <tfoot class="table-light fw-semibold">
            <tr>
                <td>@L["Total"]</td>
                <td class="text-end">@Model.Totals.Total</td>
                <td class="text-end">@Model.Totals.Delivered</td>
                <td class="text-end">@Model.Totals.Sent</td>
                <td class="text-end">@Model.Totals.Processing</td>
                <td class="text-end">@Model.Totals.Undelivered</td>
                <td class="text-end">@Model.Totals.Failed</td>
                <td class="text-end">@Model.Totals.Expired</td>
                <td></td>
            </tr>
        </tfoot>
    }
</table>
