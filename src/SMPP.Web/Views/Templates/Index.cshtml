@using SMPP.Application.Common
@using SMPP.Application.Templates
@using SMPP.Web.ViewModels.Shared
@model PagedResult<TemplateListItemDto>
@{
    ViewData["Title"] = "Templates";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Templates</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">+ New template</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Segments</th>
                    <th>CSV</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No templates yet.</td></tr>
                }
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td><code>@t.TemplateCode</code></td>
                        <td>@t.MessageSegmentCount</td>
                        <td>
                            @if (!string.IsNullOrEmpty(t.CsvFilePath))
                            {
                                <a href="~/@t.CsvFilePath" target="_blank">Download</a>
                            }
                        </td>
                        <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this template?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <partial name="_Pagination" model="@(new PaginationInfo(Model.PageNumber, Model.TotalPages))" />
    </div>
</div>
