@model SMPP.Web.ViewModels.Sending.SendFormViewModel
@{
    // Charged per part, so the readout has to show parts and not just characters - see
    // wwwroot/js/app.js's messageCounter component, which mirrors the server's SegmentCounter to
    // work them out.
    var rate = (ViewData["SendPolicy"] as SMPP.Application.Abstractions.SendPolicy)?.CreditsPerMessagePart ?? 0m;
    var counterConfig = System.Net.WebUtility.HtmlEncode(System.Text.Json.JsonSerializer.Serialize(new
    {
        rate,
        template = L["{chars} characters · {parts} part(s) · {encoding}"].Value,
        creditsTemplate = L["{credits} credits per recipient"].Value,
        unicodeLabel = L["Unicode"].Value,
        latinLabel = L["GSM"].Value,
    }));
}

<div class="mb-3" x-data="messageCounter(@Html.Raw(counterConfig))" x-init="message = $refs.messageText.value">
    <label asp-for="Message" class="form-label"></label>
    <textarea asp-for="Message" x-ref="messageText" @@input="message = $event.target.value" class="form-control" rows="4"></textarea>
    <div class="form-text" x-text="text"></div>
    <span asp-validation-for="Message" class="text-danger small"></span>
</div>
